NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
# Текущий вход: Clerk. Публичный ключ — единственная переменная NEXT_PUBLIC_*; секрет остаётся на сервере.

# Планируемые адаптеры: OpenAI и NVIDIA используют отдельные ключи. Укажите ID модели и endpoint по документации провайдера.
OPENAI_API_KEY=
OPENAI_MODEL=
OPENAI_BASE_URL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Планируемые сервисы: Liveblocks и Trigger.dev; секреты и идентификаторы только на сервере.
LIVEBLOCKS_SECRET_KEY=
TRIGGER_SECRET_KEY=
TRIGGER_PROJECT_ID=

# PostgreSQL и закрытое S3-хранилище. Имена S3_* предварительные до интеграции с A.
DATABASE_URL=
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
